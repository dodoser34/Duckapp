# Copy to .env and fill in. Never commit the real .env.
#
# Generate the secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Database (required) ---------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=duckapp
DB_PASSWORD=
DB_NAME=duckapp
# Pooled connections; raise alongside uvicorn --workers.
DUCKAPP_DB_POOL_SIZE=10
DUCKAPP_DB_POOL_TIMEOUT_SECONDS=10

# --- Secrets (required) ----------------------------------------------------
# Signs both user sessions and the feedback admin token. The app refuses to
# start if this is empty or a placeholder.
JWT_KEY=
# Sole credential for the feedback moderation panel. Use 32+ random chars.
DUCKAPP_FEEDBACK_ADMIN_CODE=

# --- Third-party services --------------------------------------------------
GIPHY_API_KEY=

# --- HTTP / security -------------------------------------------------------
DUCKAPP_HOST=127.0.0.1
DUCKAPP_PORT=8000
# Never enable auto-reload in production.
DUCKAPP_RELOAD=0
# Comma-separated Host header whitelist. Requests for any other host get a 400,
# so this MUST list your real domain before going live.
DUCKAPP_ALLOWED_HOSTS=127.0.0.1,localhost
# Anchored regex of allowed browser origins (CORS and CSRF).
DUCKAPP_CORS_ORIGIN_REGEX=^https?://(127\.0\.0\.1|localhost)(:\d+)?$
DUCKAPP_CSRF_PROTECTION_ENABLED=1
# Reject state-changing requests with no Origin/Referer at all.
DUCKAPP_CSRF_REQUIRE_ORIGIN=1
# Set to 1 only behind a trusted reverse proxy; otherwise clients can forge
# X-Forwarded-For and walk straight past the rate limits.
DUCKAPP_TRUST_PROXY_HEADERS=0

# --- Cookies ---------------------------------------------------------------
# Keep this at 1. Browsers treat http://localhost and http://127.0.0.1 as
# trustworthy origins, so Secure cookies work there too - local development
# needs no exception. Only turn it off if you must reach the dev server from
# another device over plain http:// (a LAN address gets no such exemption).
DUCKAPP_SECURE_COOKIES=1
# Set to 1 when TLS terminates in a proxy in front of the app.
DUCKAPP_BEHIND_TLS_PROXY=0
DUCKAPP_COOKIE_SAMESITE=lax
DUCKAPP_COOKIE_PATH=/
# DUCKAPP_COOKIE_DOMAIN=

# --- Sessions and rate limits ----------------------------------------------
DUCKAPP_TOKEN_TTL_SECONDS=7200
DUCKAPP_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
DUCKAPP_AUTH_RATE_LIMIT_MAX_ATTEMPTS=30
DUCKAPP_FRIEND_SEARCH_WINDOW_SECONDS=60
DUCKAPP_FRIEND_SEARCH_MAX=20
DUCKAPP_FEEDBACK_WRITE_MAX=20
DUCKAPP_FEEDBACK_READ_MAX=60
DUCKAPP_FEEDBACK_ADMIN_LOGIN_MAX=10
DUCKAPP_FEEDBACK_ADMIN_TOKEN_TTL_SECONDS=28800

# --- Account recovery email ------------------------------------------------
DUCKAPP_RECOVERY_CODE_TTL_MINUTES=20
DUCKAPP_RECOVERY_CODE_MAX_ATTEMPTS=5
DUCKAPP_SMTP_HOST=
DUCKAPP_SMTP_PORT=587
DUCKAPP_SMTP_USER=
DUCKAPP_SMTP_PASSWORD=
DUCKAPP_SMTP_FROM=
DUCKAPP_SMTP_STARTTLS=1
# DUCKAPP_SMTP_SSL=0

# --- Uploads ---------------------------------------------------------------
DUCKAPP_MAX_AVATAR_BYTES=2097152
DUCKAPP_MAX_CUSTOM_AVATARS=10

# --- Misc ------------------------------------------------------------------
DUCKAPP_LOG_LEVEL=INFO
DUCKAPP_HEARTBEAT_INTERVAL_SECONDS=30
